NODE_ENV=development
APP_ENV=development
WEB_PORT=3300
ADMIN_PORT=3301
API_PORT=4300
GAME_SERVER_PORT=4310
# Development-only credentials for loopback-bound Docker services.
DATABASE_URL=postgresql://cricketer:cricketer_dev@localhost:5432/cricketer
# Single per-process pool. Development values are deliberately conservative.
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
# Log transactions slower than this many ms (0 disables). Never logs SQL or parameters.
DATABASE_SLOW_QUERY_MS=250
# Optional: integration tests create/drop cricketer_test_* databases on this server (defaults to DATABASE_URL's).
# TEST_DATABASE_URL=postgresql://cricketer:cricketer_dev@localhost:5432/postgres
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3300,http://localhost:3301
LOG_LEVEL=info
APP_VERSION=0.1.0
NEXT_PUBLIC_API_URL=http://localhost:4300
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4310

# --- Module 3: authentication -------------------------------------------------------------
# Origins allowed to make cookie-authenticated (credentialed) requests. Must also appear in
# CORS_ORIGINS. Required for staging/production (https only).
AUTH_TRUSTED_ORIGINS=http://localhost:3300
# Session lifetimes in seconds: sliding idle window per account type, plus a hard cap.
AUTH_SESSION_TTL=2592000
AUTH_GUEST_SESSION_TTL=2592000
AUTH_SESSION_ABSOLUTE_TTL=7776000
# Minimum gap between last_seen_at writes / cookie refreshes.
AUTH_SESSION_TOUCH_INTERVAL=300
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_VERIFICATION_TOKEN_TTL=86400
AUTH_RESET_TOKEN_TTL=3600
# Cookie. Development runs over plain HTTP, so Secure is off here; staging/production REQUIRE true
# and then default the name to __Host-cricketer_session. Never set false in production.
AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_NAME=cricketer_session
# AUTH_COOKIE_SAME_SITE=lax
# Argon2id (RFC 9106 second option). Tune with `pnpm auth:benchmark-hash`.
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_PASSES=3
AUTH_ARGON2_PARALLELISM=1
AUTH_HASH_CONCURRENCY=2
# 'development' prints verification/reset links to the API log and exposes /api/v1/dev/emails
# (loopback only). Not allowed in staging/production.
EMAIL_PROVIDER=development
# Set true ONLY behind a trusted reverse proxy so per-IP rate limits see the client address.
# TRUST_PROXY=false
# Rate limits (AUTH_RL_<NAME>_MAX / AUTH_RL_<NAME>_WINDOW in seconds). Production defaults are
# strict; these relaxed development values keep local testing and e2e runs from tripping them.
AUTH_RL_GUEST_MAX=500
AUTH_RL_REGISTER_MAX=500
AUTH_RL_LOGIN_IP_MAX=500
AUTH_RL_EMAIL_ACTION_MAX=100
AUTH_RL_EMAIL_ACTION_IP_MAX=500
AUTH_RL_TOKEN_ATTEMPT_MAX=500

# Module 5 (3D viewer): optional CDN prefix for /game-assets (no trailing slash). Empty = same origin.
NEXT_PUBLIC_ASSET_BASE_URL=
