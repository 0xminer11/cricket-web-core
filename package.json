{
  "name": "the-cricketer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "dev": "pnpm prepare:dev && turbo run dev --concurrency=20",
    "build": "turbo run build --concurrency=2 && pnpm validate:data",
    "lint": "eslint . && node infrastructure/scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck --concurrency=2 && tsc -p tsconfig.tests.json",
    "test": "turbo run build --concurrency=2 --filter=\"./packages/*\" && vitest run",
    "test:integration": "INTEGRATION_TESTS=1 pnpm test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "node infrastructure/scripts/validate-data.mjs",
    "audit:dependencies": "pnpm audit --prod",
    "db:generate": "pnpm --filter @the-cricketer/database db:generate",
    "db:migrate": "turbo run build --concurrency=2 --filter=@the-cricketer/database... && pnpm --filter @the-cricketer/database db:migrate",
    "db:migrate:dev": "pnpm db:generate && pnpm db:migrate",
    "db:seed": "turbo run build --concurrency=2 --filter=@the-cricketer/database... && pnpm --filter @the-cricketer/database db:seed",
    "db:reset": "pnpm --filter @the-cricketer/database db:reset",
    "db:studio": "pnpm --filter @the-cricketer/database db:studio",
    "db:check": "turbo run build --concurrency=2 --filter=@the-cricketer/database... && pnpm --filter @the-cricketer/database db:check",
    "db:test": "turbo run build --concurrency=2 --filter=\"./packages/*\" && INTEGRATION_TESTS=1 vitest run tests/db tests/db-unit.test.ts tests/database.test.ts",
    "db:drift": "pnpm db:generate && git diff --exit-code -- packages/database/migrations && test -z \"$(git status --porcelain -- packages/database/migrations | grep '^??')\"",
    "dev:web": "pnpm prepare:dev && turbo run dev --concurrency=20 --filter=@the-cricketer/web...",
    "dev:api": "pnpm prepare:dev && turbo run dev --concurrency=20 --filter=@the-cricketer/api...",
    "dev:game-server": "pnpm prepare:dev && turbo run dev --concurrency=20 --filter=@the-cricketer/game-server...",
    "dev:admin": "pnpm prepare:dev && turbo run dev --concurrency=20 --filter=@the-cricketer/admin...",
    "prepare:dev": "turbo run build --concurrency=2 --filter=\"./packages/*\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.8.0",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.0"
  }
}
